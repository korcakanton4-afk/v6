local function lootScroller()
    local inv = guiPath("MainGui", "BackpackFrame", "Loot", "Inventory")
    return inv and inv:FindFirstChild("ScrollingFrame")
end

local function lootPanel()
    local sc = lootScroller()
    if not sc or not QuickMove then return 0 end
    local sent = 0
    for _, grp in ipairs(sc:GetChildren()) do
        if grp:IsA("GuiObject") then
            for _, slot in ipairs(grp:GetChildren()) do
                local iv = slot:FindFirstChild("Item")
                if iv and iv:IsA("ObjectValue") and iv.Value then
                    if priceOf(iv.Value.Name) >= C.LootMin then
                        pcall(function() QuickMove:FireServer(slot.Name, iv.Value.Parent) end)
                        sent = sent + 1
                    end
                end
            end
        end
    end
    return sent
end

local function currentContainer()
    local p  = RS:FindFirstChild("Players")
    local me = p and p:FindFirstChild(LP.Name)
    local st = me and me:FindFirstChild("Status")
    local gv = st and st:FindFirstChild("GameplayVariables")
    local cc = gv and gv:FindFirstChild("CurrentContainer")
    if not cc then return nil end
    local v = cc:IsA("ObjectValue") and cc.Value or cc
    return typeof(v) == "Instance" and v or nil
end

local function lootAll()
    local n = 0
    local c = currentContainer()
    if c then
        if C.UseQuickLoot and QuickLoot then
            pcall(function() QuickLoot:FireServer(c) end)
            n = n + 1
        end
        local inv = c:FindFirstChild("Inventory")
        if inv and QuickMove then
            for _, it in ipairs(inv:GetChildren()) do
                if priceOf(it.Name) >= C.LootMin then
                    pcall(function() QuickMove:FireServer(it.Name, it) end)
                    n = n + 1
                end
            end
        end
    end
    n = n + lootPanel()
    if n == 0 then notify("лута нет", Color3.fromRGB(255, 180, 60))
    else notify(("отправлено: %d"):format(n)) end
end

