local function newEsp(kind)
    local pair = CLR[kind] or CLR.player
    local o = {on = false, pair = pair, col = pair.v}
    o.b = draw(Drawing.new("Square")); o.b.Thickness = 1; o.b.Filled = false; o.b.Visible = false
    o.n = draw(Drawing.new("Text")); o.n.Size = 12; o.n.Font = 2; o.n.Center = true; o.n.Outline = true; o.n.Visible = false
    o.d = draw(Drawing.new("Text")); o.d.Size = 11; o.d.Font = 2; o.d.Center = true; o.d.Outline = true; o.d.Visible = false
    o.h = draw(Drawing.new("Line")); o.h.Thickness = 2; o.h.Visible = false
    o.t = draw(Drawing.new("Line")); o.t.Thickness = 1; o.t.Visible = false
    o.k = draw(Drawing.new("Line")); o.k.Thickness = 1; o.k.Visible = false

    function o:upd(inst, root, dist, label, hp, visible)
        local cam = WS.CurrentCamera
        local col = visible and self.pair.v or self.pair.h

        if C.Chams then
            if not self.hl then
                self.hl = Instance.new("Highlight")
                self.hl.DepthMode = C.ChamThrough and Enum.HighlightDepthMode.AlwaysOnTop
                    or Enum.HighlightDepthMode.Occluded
                self.hl.Parent = inst
            end
            self.hl.Enabled = true
            self.hl.FillColor = col
            self.hl.OutlineColor = col
            self.hl.FillTransparency = visible and C.ChamFillVis or C.ChamFillHid
            self.hl.OutlineTransparency = visible and 0.15 or 0.55
        elseif self.hl then
            self.hl.Enabled = false
        end

        local hd = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 1.1, 0))
        local ft = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 2.4, 0))
        if not hd.Z or hd.Z <= 0 then return self:hideBox() end
        local hgt = math.abs(ft.Y - hd.Y)
        local w = hgt * 0.55
        local top = math.min(hd.Y, ft.Y)
        local lf = hd.X - w * 0.5
        self.on = true

        if C.Box then
            self.b.Visible = true
            self.b.Size = Vector2.new(w, hgt)
            self.b.Position = Vector2.new(lf, top)
            self.b.Color = col
        else self.b.Visible = false end

        if C.Name then
            self.n.Visible = true
            self.n.Text = label or ""
            self.n.Color = col
            self.n.Position = Vector2.new(hd.X, top - 15)
        else self.n.Visible = false end

        if C.Dist then
            self.d.Visible = true
            self.d.Text = ("%d m"):format(math.floor(dist / 3.5))
            self.d.Position = Vector2.new(hd.X, top + hgt + 2)
        else self.d.Visible = false end

        if hp and C.Health then
            self.h.Visible = true
            self.h.From = Vector2.new(lf - 4, top + hgt)
            self.h.To = Vector2.new(lf - 4, top + hgt * (1 - hp))
            self.h.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 60)
        else self.h.Visible = false end

        if C.Tracer then
            self.t.Visible = true
            self.t.Color = col
            self.t.From = C.TracerTop and Vector2.new(cam.ViewportSize.X / 2, 0)
                or Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
            self.t.To = Vector2.new(hd.X, top + hgt)
        else self.t.Visible = false end

        if C.Skeleton and inst:IsA("Model") then
            local hrp = inst:FindFirstChild("HumanoidRootPart")
            local head = inst:FindFirstChild("Head") or inst:FindFirstChild("HeadTopHitBox")
            if hrp and head then
                local a = cam:WorldToViewportPoint(hrp.Position)
                local b = cam:WorldToViewportPoint(head.Position)
                if a.Z > 0 and b.Z > 0 then
                    self.k.Visible = true
                    self.k.Color = col
                    self.k.From = Vector2.new(a.X, a.Y)
                    self.k.To = Vector2.new(b.X, b.Y)
                else self.k.Visible = false end
            else self.k.Visible = false end
        else self.k.Visible = false end
    end

    function o:hideBox()
        for _, x in ipairs({self.b, self.n, self.d, self.h, self.t, self.k}) do x.Visible = false end
    end

    function o:hide()
        self:hideBox()
        if self.hl then self.hl.Enabled = false end
    end

    function o:kill()
        for _, x in ipairs({self.b, self.n, self.d, self.h, self.t, self.k}) do pcall(function() x:Remove() end) end
        if self.hl then pcall(function() self.hl:Destroy() end) end
    end
    return o
end

local function rootPart(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChildWhichIsA("BasePart")
    end
    return inst:FindFirstChildWhichIsA("BasePart")
end

