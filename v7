local function nearest(set, maxD)
    local me = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not me then return nil end
    local best, bd = nil, maxD
    for inst in pairs(set) do
        local r = rootPart(inst)
        if r then
            local d = (r.Position - me.Position).Magnitude
            if d < bd then bd = d best = {inst = inst, part = r, d = d} end
        end
    end
    return best
end

local function tryInteract(part, fallback)
    lookAt(part.Position)
    task.wait(0.18)
    for _ = 1, 6 do
        local name, btn = activeInteraction()
        if name then press(btn) return name end
        task.wait(0.06)
    end
    if fallback then pcall(fallback) end
    return nil
end

local function openDoor()
    local t = nearest(L.door, 45)
    if not t then return notify("двери рядом нет", Color3.fromRGB(255, 180, 60)) end
    local used = tryInteract(t.part, function()
        if DoorRem then
            DoorRem:FireServer(t.inst)
            DoorRem:FireServer(t.inst, "Open")
        end
    end)
    if used then notify("дверь: " .. used)
    else notify("дверь: без кнопки, дёрнул remote", Color3.fromRGB(255, 180, 60)) end
    spy(("OPEN_DOOR %s used=%s"):format(t.inst:GetFullName(), tostring(used)))
end

local function openContainer()
    local t = nearest(L.box, 20)
    if not t then return notify("контейнеров рядом нет", Color3.fromRGB(255, 180, 60)) end
    local used = tryInteract(t.part, function()
        if LootRem then LootRem:InvokeServer(t.inst) end
        if QuickLoot then QuickLoot:FireServer(t.inst) end
    end)
    if used then notify("контейнер: " .. used)
    else notify("контейнер: без кнопки, дёрнул remote", Color3.fromRGB(255, 180, 60)) end
    spy(("OPEN_BOX %s used=%s"):format(t.inst:GetFullName(), tostring(used)))
end

local function interactNow()
    local name, btn = activeInteraction()
    if name then press(btn) return notify("нажато: " .. name) end
    local d = nearest(L.door, 45)
    if d then return openDoor() end
    local b = nearest(L.box, 20)
    if b then return openContainer() end
    notify("нечего нажимать", Color3.fromRGB(255, 180, 60))
end

