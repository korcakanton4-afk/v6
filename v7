G.VenicePD_Unload = function()
    if not running then return end
    running = false
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    for i, o in pairs(esp) do pcall(function() o:kill() end) esp[i] = nil end
    for _, d in ipairs(draws) do pcall(function() d:Remove() end) end
    for _, i in ipairs(insts) do pcall(function() i:Destroy() end) end
    if BulletTbl and BulletOrig then pcall(function() BulletTbl.CreateBullet = BulletOrig end) end
    if speedHook then pcall(function() hookmetamethod(game, "__newindex", speedHook) end) end
    if Ammo then
        for a, o in pairs(cache) do
            if a.Parent then
                pcall(function()
                    a:SetAttribute("RecoilStrength", o.r)
                    a:SetAttribute("ProjectileDrop", o.d)
                    a:SetAttribute("Drag", o.g)
                end)
            end
        end
    end
    pcall(function()
        Lighting.Brightness = base.b
        Lighting.ClockTime = base.t
        Lighting.FogEnd = base.f
        Lighting.FogStart = base.s
        if Camera then Camera.FieldOfView = base.fov end
        WS.Terrain.Decoration = true
        LP.CameraMinZoomDistance = 0.5
        LP.CameraMaxZoomDistance = 0.5
    end)
    pcall(function() Gui:Destroy() end)
    G.VenicePD_Unload = nil
end

