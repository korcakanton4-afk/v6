local function containerInfo(m)
    local inv = m:FindFirstChild("Inventory")
    local props = m:FindFirstChild("Properties")
    local cap = inv and inv:GetAttribute("Container") or 0
    local ctype = props and props:GetAttribute("ContainerType") or "?"
    local total, cnt, names = 0, 0, {}
    if inv then
        for _, it in ipairs(inv:GetChildren()) do
            cnt = cnt + 1
            total = total + priceOf(it.Name)
            if cnt <= 3 then names[#names+1] = it.Name end
        end
    end
    return ctype, cap, cnt, total, table.concat(names, ", ")
end

